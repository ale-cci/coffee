export function l $fn.fp() {
@start
%.tmem1 =l call $mmap(l 0, l 72, w 7, w 34, w -1, w 0)
call $llvm_init_trampoline(l %.tmem1, l @.1, l 0)
%.trmp1 =l call $llvm_adjust_trampoline(l %.tmem1)
%x =l copy %.trmp1
ret %x
}
function w @.1(l %.0, w %.a.arg, w %.b.arg) {
@start
%a =l alloc4 4
storew %.a.arg, %a
%b =l alloc4 4
storew %.b.arg, %b
%.tmp2 =w loadw %a
%.tmp3 =w loadw %b
%.tmp4 =w add %.tmp2, %.tmp3
ret %.tmp4
}

export function w $main() {
@start
%.tmp6 =l call $fn.fp()
%j.7 =l alloc8 8
storel %.tmp6, %j.7
%.tmp8 =l loadl %j.7
%.tmp9 =w call %.tmp8(w 3, w 4)
ret %.tmp9
}
