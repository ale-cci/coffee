export function $fn.v() {
@start
%t.0 =l alloc8 16
%.tmp1 =l copy %t.0
storel 0, %.tmp1
%.tmp2 =l add %t.0, 8
storew 0, %.tmp2
%.tmp3 =l add %t.0, 12
storew 0, %.tmp3
@.b5.start
    %.tmp_ptr..b5 =l add %t.0, 8
    %.tmp1..b5 =w loadw %.tmp_ptr..b5
    %.tmp_cap_ptr..b5 =l add %t.0, 12
    %.tmp3..b5 =w loadw %.tmp_cap_ptr..b5
    %.tmp4..b5 =w csgew %.tmp1..b5, %.tmp3..b5
    jnz %.tmp4..b5, @.b5.if.true, @.b5.if.end

@.b5.if.true
    %.tmp9..b5 =w mul %.tmp3..b5, 2
    %.tmp10..b5 =w add %.tmp9..b5, 1
    storew %.tmp10..b5, %.tmp_cap_ptr..b5
    %.tmp13..b5 =l loadl %t.0
    %.ext_cap..b5 =l extsw %.tmp10..b5
    %.size..b5 =l mul %.ext_cap..b5, 4
    %.tmp20..b5 =l call $realloc(l %.tmp13..b5, l %.size..b5)
    storel %.tmp20..b5, %t.0
    jmp @.b5.if.end

@.b5.if.end
    %.tmp25..b5 =l loadl %t.0
    %.tmp24..b5 =w loadw %.tmp_ptr..b5
    %.ext_len..b5 =l extsw %.tmp24..b5
    %.off26..b5 =l mul %.ext_len..b5, 4
    %.tmp26..b5 =l add %.tmp25..b5, %.off26..b5
    storew 3, %.tmp26..b5
    %.tmp30..b5 =w add %.tmp24..b5, 1
    storew %.tmp30..b5, %.tmp_ptr..b5
    %.tmp4 =l copy %t.0
call $memcpy(l %t.0, l %.tmp4, l 16)
ret
}
