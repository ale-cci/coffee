export function $fn.v() {
@start
%t.0 =l alloc8 16
%.tmp1 =l copy %t.0
storel 0, %.tmp1
%.tmp2 =l add %t.0, 8
storew 0, %.tmp2
%.tmp3 =l add %t.0, 12
storew 0, %.tmp3
%.tmp4 =l add %t.0, 8
%.tmp5 =w loadw %.tmp4
%t_len.6 =l alloc4 4
storew %.tmp5, %t_len.6
@.b8.start
    %.tmp_ptr..b8 =l add %t.0, 8
    %.tmp1..b8 =w loadw %.tmp_ptr..b8
    %.tmp_cap_ptr..b8 =l add %t.0, 12
    %.tmp3..b8 =w loadw %.tmp_cap_ptr..b8
    %.tmp4..b8 =w csgew %.tmp1..b8, %.tmp3..b8
    jnz %.tmp4..b8, @.b8.if.true, @.b8.if.end

@.b8.if.true
    %.tmp9..b8 =w mul %.tmp3..b8, 2
    %.tmp10..b8 =w add %.tmp9..b8, 1
    storew %.tmp10..b8, %.tmp_cap_ptr..b8
    %.tmp13..b8 =l loadl %t.0
    %.ext_cap..b8 =l extsw %.tmp10..b8
    %.size..b8 =l mul %.ext_cap..b8, 4
    %.tmp20..b8 =l call $realloc(l %.tmp13..b8, l %.size..b8)
    storel %.tmp20..b8, %t.0
    jmp @.b8.if.end

@.b8.if.end
    %.tmp25..b8 =l loadl %t.0
    %.tmp24..b8 =w loadw %.tmp_ptr..b8
    %.ext_len..b8 =l extsw %.tmp24..b8
    %.off26..b8 =l mul %.ext_len..b8, 4
    %.tmp26..b8 =l add %.tmp25..b8, %.off26..b8
    storew 3, %.tmp26..b8
    %.tmp30..b8 =w add %.tmp24..b8, 1
    storew %.tmp30..b8, %.tmp_ptr..b8
    %.tmp7 =l copy %t.0
call $memcpy(l %t.0, l %.tmp7, l 16)
ret
}
