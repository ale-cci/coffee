type :.T.type = { w }
export function $fn.v() {
@start
%a.0 =l alloc4 4
storew 0, %a.0
%b.1 =l alloc4 4
storeb 0, %b.1
%c.2 =l alloc8 8
storel 0, %c.2
%d.3 =l alloc8 13
%.tmp4 =l copy %d.3
storew 0, %.tmp4
%.tmp5 =l add %d.3, 4
storeb 0, %.tmp5
%.tmp6 =l add %d.3, 5
storel 0, %.tmp6
%e.7 =l alloc8 8
%.tmp8 =l copy %e.7
storew 0, %.tmp8
%f.9 =l alloc4 4
storeb 0, %f.9
ret
}
