-- requires those 8 arguments:
-- 1. builtin prefix
-- 2. array type (unused in QBE)
-- 3. array id
-- 4. assigned type (unused in QBE)
-- 5. assigned id
-- 6. destination id
-- 7. element size in bytes (int)
-- 8. QBE store instruction (str)
--
-- Has the following behaviour:
-- {
--   T[] t
--   if t.len >= t.cap {
--       t.cap = t.cap * 2 + 1
--       t.c_arr = (T*) realloc((chr*) t.c_arr, sizeof(T) * t.cap)
--   }
--   t.c_arr[t.len] = val
--   t.len = t.len + 1
--
--   j := t
-- }
str append_tmpl() {
    return `@%1$s.start
    %9$s.tmp_ptr.%1$s =l add %3$s, 8
    %9$s.tmp1.%1$s =w loadw %9$s.tmp_ptr.%1$s
    %9$s.tmp_cap_ptr.%1$s =l add %3$s, 12
    %9$s.tmp3.%1$s =w loadw %9$s.tmp_cap_ptr.%1$s
    %9$s.tmp4.%1$s =w csgew %9$s.tmp1.%1$s, %9$s.tmp3.%1$s
    jnz %9$s.tmp4.%1$s, @%1$s.if.true, @%1$s.if.end

@%1$s.if.true
    %9$s.tmp9.%1$s =w mul %9$s.tmp3.%1$s, 2
    %9$s.tmp10.%1$s =w add %9$s.tmp9.%1$s, 1
    storew %9$s.tmp10.%1$s, %9$s.tmp_cap_ptr.%1$s
    %9$s.tmp13.%1$s =l loadl %3$s
    %9$s.ext_cap.%1$s =l extsw %9$s.tmp10.%1$s
    %9$s.size.%1$s =l mul %9$s.ext_cap.%1$s, %7$d
    %9$s.tmp20.%1$s =l call $realloc(l %9$s.tmp13.%1$s, l %9$s.size.%1$s)
    storel %9$s.tmp20.%1$s, %3$s
    jmp @%1$s.if.end

@%1$s.if.end
    %9$s.tmp25.%1$s =l loadl %3$s
    %9$s.tmp24.%1$s =w loadw %9$s.tmp_ptr.%1$s
    %9$s.ext_len.%1$s =l extsw %9$s.tmp24.%1$s
    %9$s.off26.%1$s =l mul %9$s.ext_len.%1$s, %7$d
    %9$s.tmp26.%1$s =l add %9$s.tmp25.%1$s, %9$s.off26.%1$s
    %8$s %5$s, %9$s.tmp26.%1$s
    %9$s.tmp30.%1$s =w add %9$s.tmp24.%1$s, 1
    storew %9$s.tmp30.%1$s, %9$s.tmp_ptr.%1$s
    %6$s =l copy %3$s\n`
}
