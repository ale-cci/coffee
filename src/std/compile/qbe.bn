import "../string" as string
import "../io" as io
import "../sys" as sys


chr* string_to_qbe(chr* text) {
    str_len := string.strlen(text)

    buf := ""

    -- ignore start and end quotes for string length calculation
    for i := 1; i < str_len -1; i = i + 1 {

        if text[i] == '\x22' {
            io.asprintf(&buf, `%s\\"`, buf)
        } elif text[i] == '\x0A' {
            io.asprintf(&buf, "%s\\n", buf)
        } elif text[i] == '\x0D' {
            io.asprintf(&buf, "%s\\r", buf)
        } elif text[i] == '\x5C' {
            if text[i + 1] == 'n' | text[i + 1] == 'N' {
                io.asprintf(&buf, "%s\\n", buf)
                i = i + 1
            } elif text[i + 1] == 't' | text[i + 1] == 'T' {
                io.asprintf(&buf, "%s\\t", buf)
                i = i + 1
            } elif text[i + 1] == '\x5C' {
                io.asprintf(&buf, "%s\\\\", buf)
                i = i + 1
            } elif text[i + 1] == 'x' {
                -- hex character
                i = i + 2
                io.asprintf(&buf, "%s\\x%c%c", buf, string.toupper(text[i]), string.toupper(text[i+1]))
                i = i + 1
            } else {
                io.asprintf(&buf, "%s%c", buf, text[i])
            }
        } else {
            io.asprintf(&buf, "%s%c", buf, text[i])
        }

    }

    io.asprintf(&buf, "\x22%s\x22", buf)
    return buf
}

int qbe_str_len(chr* text) {
    -- Calculates the length of the string, excluding quotes and accounting for escape sequences.
    int len = 0
    str_len := string.strlen(text)
    for i := 1 ; i < str_len - 1 ; i = i + 1 {
        if text[i] == '\x5C' {
            i = i + 1
        }
        len = len + 1
    }
    return len
}


chr* chr_to_qbe(chr* chr_repr) {
    int intval
    chr* buf
    chr chrval

    chr_len := string.strlen(chr_repr)
    if chr_len == 6 {
        io.sscanf(chr_repr, "'\\x%x'", &intval)
        io.asprintf(&buf, "%d", intval)
    } elif chr_len == 5 {
        io.sscanf(chr_repr, "'\\%x'", &intval)
        io.asprintf(&buf, "%d", intval)
    } elif chr_len == 4 {
        io.sscanf(chr_repr, "'\\%c'", &chrval)
        if chrval == 'n' {
            buf = "10"
        } else {
            return (chr*) null
        }
    } elif chr_len == 3 {
        io.sscanf(chr_repr, "'%c'", &intval)
        io.asprintf(&buf, "%d", intval)
    } else {
        return (chr*) null
    }
    return buf
}
