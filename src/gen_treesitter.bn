import "std/sys" as sys
import "std/ioutil" as ioutil
import "std/io" as io
import "std/ast/parser" as parser
import "std/ast/syntax" as syntax
import "./dstring" as ds
import "std/string" as string
import "std/ast/errors" as errors

ds.String sequence_repr(parser.Matcher* head) {
    builder := ds.new_builder(200)
    
    if head == null {
        ds.append_cstr(&builder, "")
        return builder
    }
    
    -- Se la testa ha delle alternative, questa e' una scelta tra intere sequenze!
    if head.alternative != null {
        ds.append_cstr(&builder, "choice(")
        
        for curr := head; curr != null; {
            alt := curr.alternative
            curr.alternative = (parser.Matcher*) null
            
            branch_repr := sequence_repr(curr)
            ds.append(&builder, &branch_repr)
            ds.free(&branch_repr)
            
            curr.alternative = alt
            curr = alt
            if curr != null {
                ds.append_cstr(&builder, ", ")
            }
        }
        
        ds.append_cstr(&builder, ")")
        return builder
    }
    
    -- Altrimenti, e' una sequenza lineare. Calcoliamo la lunghezza
    count := 0
    for curr := head; curr != null; curr = curr.next {
        count = count + 1
    }
    
    if count == 1 {
        item_repr := matcher_repr(head)
        ds.append(&builder, &item_repr)
        ds.free(&item_repr)
        return builder
    }
    
    ds.append_cstr(&builder, "seq(")
    for curr := head; curr != null; {
        item_repr := matcher_repr(curr)
        ds.append(&builder, &item_repr)
        ds.free(&item_repr)
        
        curr = curr.next
        if curr != null {
            ds.append_cstr(&builder, ", ")
        }
    }
    ds.append_cstr(&builder, ")")
    
    return builder
}

ds.String matcher_repr(parser.Matcher* m) {
    builder := ds.new_builder(200)
    
    if m == null {
        ds.append_cstr(&builder, "")
        return builder
    }
    
    -- Handle nested EBNF parentheses/groups
    if m.type == '\x00' & m.submatcher != null {
        sub_repr := sequence_repr(m.submatcher)
        
        if m.times == '?' {
            ds.append_cstr(&builder, "optional(")
            ds.append(&builder, &sub_repr)
            ds.append_cstr(&builder, ")")
        } elif m.times == '*' {
            ds.append_cstr(&builder, "repeat(")
            ds.append(&builder, &sub_repr)
            ds.append_cstr(&builder, ")")
        } elif m.times == '+' {
            ds.append_cstr(&builder, "repeat1(")
            ds.append(&builder, &sub_repr)
            ds.append_cstr(&builder, ")")
        } else {
            ds.append(&builder, &sub_repr)
        }
        
        ds.free(&sub_repr)
        return builder
    }
    
    -- Handle base leaf nodes
    leaf_repr := ds.new_builder(100)
    if m.type == 'v' {
        ds.append_cstr(&leaf_repr, m.value)
    } elif m.type == 'a' {
        ds.append_cstr(&leaf_repr, "$.")
        ds.append_cstr(&leaf_repr, m.value)
    } elif m.type == 't' {
        ds.append_cstr(&leaf_repr, "$.")
        ds.append_cstr(&leaf_repr, m.value)
    } else {
        ds.append_cstr(&leaf_repr, "null")
    }
    
    -- Apply multiplicity
    if m.times == '?' {
        ds.append_cstr(&builder, "optional(")
        ds.append(&builder, &leaf_repr)
        ds.append_cstr(&builder, ")")
    } elif m.times == '*' {
        ds.append_cstr(&builder, "repeat(")
        ds.append(&builder, &leaf_repr)
        ds.append_cstr(&builder, ")")
    } elif m.times == '+' {
        ds.append_cstr(&builder, "repeat1(")
        ds.append(&builder, &leaf_repr)
        ds.append_cstr(&builder, ")")
    } else {
        ds.append(&builder, &leaf_repr)
    }
    
    ds.free(&leaf_repr)
    return builder
}

void print_string_rule() {
    io.printf("    STRING: $ => /")
    io.printf("%c", '"')
    io.printf("(")
    io.printf("%c", '\x5c')
    io.printf("%c", '\x5c')
    io.printf("%c", '"')
    io.printf("|[^")
    io.printf("%c", '"')
    io.printf("])*")
    io.printf("%c", '"')
    io.printf("|")
    io.printf("%c", '`')
    io.printf("(")
    io.printf("%c", '\x5c')
    io.printf("%c", '\x5c')
    io.printf("%c", '`')
    io.printf("|[^")
    io.printf("%c", '`')
    io.printf("])*")
    io.printf("%c", '`')
    io.printf("/,\n")
}

void main() {
    gfile := ioutil.str_as_file(syntax.grammar())
    ctx := parser.new_context(gfile)
    io.fclose(gfile)

    grammar := parser.parse_grammar(ctx)
    if grammar == null {
        io.printf("Error parsing grammar\n")
        sys.exit(1)
    }

    -- Preambolo standard
    io.printf("module.exports = grammar({\n")
    io.printf("  name: %ccoffee%c,\n\n", '"', '"')
    io.printf("  extras: $ => [\n")
    io.printf("    /[\\s\\t]+/,\n")
    io.printf("    $.COMMENT,\n")
    io.printf("  ],\n\n")
    
    -- Aggiungiamo i conflitti Tree-sitter per gestire le ambiguita' sintattiche
    io.printf("  conflicts: $ => [\n")
    io.printf("    [$.destination, $.basic_type],\n")
    io.printf("    [$.dotted_name, $.fn_params],\n")
    io.printf("  ],\n\n")

    io.printf("  rules: {\n")

    -- Stampiamo le regole dell'EBNF prima in modo che 'start' sia la prima regola (root rule)
    for i := 0; true; i = i + 1 {
        rule := grammar[i]
        if rule == null {
            break
        }
        
        if string.strcmp(rule.name, "expressions") == 0 {
            io.printf("    expressions: $ => repeat1($.expression),\n")
        } elif string.strcmp(rule.name, "block") == 0 {
            io.printf("    block: $ => seq(%c{%c, $.NL, optional($.expressions), %c}%c),\n", '"', '"', '"', '"')
        } else {
            rule_content := sequence_repr(rule.matcher)
            io.printf("    %s: $ => %s,\n", rule.name, rule_content.string)
            ds.free(&rule_content)
        }
    }

    -- Token lessicali standard (Option A) messi alla fine
    io.printf("    WORD: $ => /[a-zA-Z_][a-zA-Z0-9_]*/,\n")
    io.printf("    NUMBER: $ => /[0-9]+/,\n")
    print_string_rule()
    io.printf("    CHR: $ => /'(\\\\\\\\'|[^\\'])'/,\n")
    io.printf("    NL: $ => '\\n',\n")
    io.printf("    COMMENT: $ => /--.*/,\n")
    io.printf("    OPERATOR: $ => /[\\+\\-\\*\\/%%&\\|<=>!]+/,\n")

    io.printf("  }\n")
    io.printf("});\n")
    sys.exit(0)
}
